{
  "name": "churn-webapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "React + Express + SQLite web application for churn prediction and retention analytics",
  "scripts": {
    "setup": "npm install && npm --prefix client install",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "dev": "concurrently -n api,web -c yellow,magenta \"node --watch server/index.js\" \"npm --prefix client run dev\"",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}

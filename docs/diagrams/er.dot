digraph G { rankdir=LR; node [shape=plaintext, fontname="Helvetica", fontsize=10];
 customers [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e9f5f3"><b>customers</b></td></tr><tr><td align="left">PK customer_id</td></tr><tr><td align="left">gender, senior_citizen, partner, dependents</td></tr><tr><td align="left">tenure, contract, payment_method</td></tr><tr><td align="left">internet_service + 6 add-on columns</td></tr><tr><td align="left">monthly_charges, total_charges</td></tr><tr><td align="left">churn (0/1)</td></tr></table>>];
 risk [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fdf0d5"><b>customer_risk</b></td></tr><tr><td align="left">PK, FK customer_id</td></tr><tr><td align="left">churn_probability</td></tr><tr><td align="left">predicted_churn</td></tr><tr><td align="left">risk_level (Low/Medium/High)</td></tr><tr><td align="left">scored_at</td></tr></table>>];
 pred [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#fbe4de"><b>predictions</b></td></tr><tr><td align="left">PK prediction_id</td></tr><tr><td align="left">customer_ref (optional)</td></tr><tr><td align="left">input_json, tenure, contract, monthly_charges</td></tr><tr><td align="left">churn_probability, predicted_churn</td></tr><tr><td align="left">risk_level, created_at</td></tr></table>>];
 reco [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e7eef7"><b>recommendations</b></td></tr><tr><td align="left">PK recommendation_id</td></tr><tr><td align="left">FK prediction_id</td></tr><tr><td align="left">action</td></tr><tr><td align="left">reason</td></tr></table>>];
 cases [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e9f5f3"><b>retention_cases</b></td></tr><tr><td align="left">PK, FK customer_id</td></tr><tr><td align="left">status (New, Contacted, Offer sent,</td></tr><tr><td align="left">Retained, Lost)</td></tr><tr><td align="left">note, updated_by, updated_at</td></tr></table>>];
 users [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td bgcolor="#e7eef7"><b>users</b></td></tr><tr><td align="left">PK user_id</td></tr><tr><td align="left">username (unique)</td></tr><tr><td align="left">password_hash (bcrypt)</td></tr><tr><td align="left">role (admin, analyst)</td></tr></table>>];
 customers->risk [label="1 : 1", fontsize=9]; customers->cases [label="1 : 0..1", fontsize=9]; pred->reco [label="1 : many", fontsize=9]; }
